import { ScrollView, ListView, Palette as StdPalette } from "std-widgets.slint";

// ---- theme: GitHub light + dark, switched on the OS colour scheme -----------
// Slint exposes the desktop scheme through StdWidgets `Palette.color-scheme`.
// We define BOTH GitHub palettes and pick per-property. Headless defaults to light.
global Theme {
    out property <bool> dark: StdPalette.color-scheme == ColorScheme.dark;

    out property <color> bg:        dark ? #0d1117 : #ffffff;
    out property <color> panel:     dark ? #161b22 : #f6f8fa;
    out property <color> border:    dark ? #30363d : #d0d7de;
    out property <color> text:      dark ? #e6edf3 : #1f2328;
    out property <color> muted:     dark ? #8b949e : #656d76;
    out property <color> accent:    dark ? #2f81f7 : #0969da;
    out property <color> sel:       dark ? #1f6feb : #ddf4ff;
    out property <color> add-bg:    dark ? #12261e : #e6ffec;
    out property <color> add-mark:  dark ? #2ea043 : #abf2bc;
    out property <color> del-bg:    dark ? #25171c : #ffebe9;
    out property <color> del-mark:  dark ? #f85149 : #ff8182;
    out property <color> add-fg:    dark ? #3fb950 : #1a7f37;
    out property <color> del-fg:    dark ? #f85149 : #cf222e;
    out property <color> hunk-bg:   dark ? #1f6feb : #ddf4ff;
    // a subtle hover fill that works in both schemes
    out property <color> hover:     dark ? #21262d : #eaeef2;
    // tooltip background
    out property <color> tip-bg:    dark ? #1c2128 : #1f2328;
}

// ---- data structs (mirrored in Rust) --------------------------------------
export struct Span { text: string, col: color }

export struct CommitRow {
    short: string, date: string, author: string, title: string,
    current: bool, is-from: bool, is-to: bool, working: bool,
}

// One flattened node of the file tree, built in Rust.
//  - is-dir folders show an icon + name + a disclosure arrow and toggle children.
//  - file leaves show an icon + file NAME + `+added −removed` counts and scroll the diff.
//  - `visible` is recomputed in Rust on expand/collapse; hidden rows are skipped.
export struct TreeNode {
    depth: int,
    is-dir: bool,
    expanded: bool,
    visible: bool,
    name: string,
    icon: string,
    added: int,
    removed: int,
    file-index: int,   // index into the diff's file list (leaves only)
}

// One row in the diff body. kind: 0 = code line, 1 = file header, 2 = commit message.
export struct DiffItem {
    kind: int,
    code-kind: int,   // 0 ctx, 1 add, 2 del, 3 hunk-header
    old-no: string,
    new-no: string,
    sign: string,
    spans: [Span],
    path: string,
    added: int,
    removed: int,
    text: string,
    sub: string,      // message subtitle
    row-h: length,    // precomputed row height (kept in sync with Rust offset math)
}

// ---- a toolbar tool button with a hover tooltip ---------------------------
component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active;
    callback clicked;
    width: 30px;
    height: 26px;
    border-radius: 5px;
    background: ta.has-hover ? (active ? Theme.sel : Theme.hover) : (active ? Theme.sel : transparent);
    Text {
        text: glyph;
        color: active ? (Theme.dark ? white : Theme.accent) : Theme.text;
        font-family: "monospace";
        font-size: 13px;
        font-weight: active ? 800 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover: Rectangle {
        y: parent.height + 4px;
        background: Theme.tip-bg;
        border-radius: 4px;
        width: tipText.preferred-width + 12px;
        height: tipText.preferred-height + 8px;
        z: 100;
        tipText := Text {
            text: tip;
            color: white;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component EndpointButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: active ? Theme.accent : Theme.hover;
    border-width: 1px;
    border-color: Theme.border;
    Text {
        text: glyph;
        color: active ? white : Theme.muted;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "git-review · slint";
    // Exact size to match the headless Xvfb canvas (no black border).
    width: 1280px;
    height: 800px;
    background: Theme.bg;

    // ---- inputs from Rust ----
    in property <[CommitRow]> commits;
    in property <[TreeNode]> tree;
    in property <[DiffItem]> diff-items;
    in property <string> summary;
    in property <int> total-added;
    in property <int> total-removed;
    in property <int> file-count;
    in property <string> repo-name;
    // sticky header
    in property <string> sticky-path;
    in property <int> sticky-added;
    in property <int> sticky-removed;
    in property <bool> sticky-visible;
    // settings (driven by Rust)
    in property <bool> wrap-lines;
    in property <bool> show-space;
    in property <bool> line-numbers;
    in property <length> diff-font: 12px;

    // ---- callbacks to Rust ----
    callback select-commit(int);
    callback set-from(int);
    callback set-to(int);
    callback select-file(int);     // file-index of a tree leaf
    callback toggle-node(int);     // tree-row index of a folder
    callback toggle-wrap();
    callback toggle-space();
    callback toggle-line-numbers();
    callback font-inc();
    callback font-dec();
    callback scrolled(length);       // reports scroll offset for sticky calc

    // resizable layout state
    property <length> side-width: 320px;
    property <length> commits-height: 360px;
    property <length> line-h: diff-font * 1.5;

    public function scroll-diff-to(y: length) {
        flick.viewport-y = -y;
        root.scrolled(y);
    }

    // ===== ROOT: full-width toolbar on top, then [side | handle | main] ======
    VerticalLayout {
        // ===== TOOLBAR (full window width, pinned at the very top) ===========
        Rectangle {
            height: 40px;
            background: Theme.panel;
            // bottom border so it reads as a toolbar
            Rectangle {
                height: 1px;
                y: parent.height - 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: summary;
                    color: Theme.text;
                    font-family: "monospace";
                    font-weight: 700;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: "+" + total-added;
                    color: Theme.add-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Text {
                    text: "−" + total-removed;
                    color: Theme.del-fg;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 4px;
                    ToolButton { glyph: "⤶"; tip: "Word wrap"; active: wrap-lines;
                        clicked => { root.toggle-wrap(); } }
                    ToolButton { glyph: "␣"; tip: "Show space changes"; active: show-space;
                        clicked => { root.toggle-space(); } }
                    ToolButton { glyph: "A-"; tip: "Decrease font size";
                        clicked => { root.font-dec(); } }
                    ToolButton { glyph: "A+"; tip: "Increase font size";
                        clicked => { root.font-inc(); } }
                    ToolButton { glyph: "#"; tip: "Show line numbers"; active: line-numbers;
                        clicked => { root.toggle-line-numbers(); } }
                }
            }
        }

        // ===== BELOW THE TOOLBAR: side panel | handle | main diff ============
        HorizontalLayout {
            // ----- LEFT SIDE PANEL ------------------------------------------
            Rectangle {
                width: side-width;
                background: Theme.panel;
                VerticalLayout {
                    // ---- commit list ----
                    Rectangle {
                        height: commits-height;
                        background: Theme.panel;
                        VerticalLayout {
                            Text {
                                text: "COMMITS · " + repo-name;
                                color: Theme.muted;
                                font-size: 10px;
                                font-weight: 700;
                                height: 22px;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                            ListView {
                                for c[i] in commits: Rectangle {
                                    height: 52px;
                                    background: c.current ? Theme.sel : transparent;
                                    row-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-commit(i); }
                                    }
                                    Rectangle {
                                        height: 1px;
                                        y: parent.height - 1px;
                                        background: Theme.border;
                                    }
                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        spacing: 3px;
                                        // line 1
                                        HorizontalLayout {
                                            spacing: 4px;
                                            height: 18px;
                                            if !c.working: EndpointButton {
                                                glyph: "◀";
                                                active: c.is-from;
                                                clicked => { root.set-from(i); }
                                            }
                                            if !c.working: EndpointButton {
                                                glyph: "▶";
                                                active: c.is-to;
                                                clicked => { root.set-to(i); }
                                            }
                                            Text {
                                                text: c.short;
                                                color: Theme.accent;
                                                font-family: "monospace";
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: c.date;
                                                color: Theme.muted;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text {
                                                text: c.author;
                                                color: Theme.muted;
                                                font-size: 10px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                max-width: 110px;
                                            }
                                        }
                                        // line 2
                                        Text {
                                            text: c.title;
                                            color: Theme.text;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // ---- vertical resize handle ----
                    Rectangle {
                        height: 6px;
                        background: vh.has-hover ? Theme.accent : Theme.border;
                        vh := TouchArea {
                            mouse-cursor: ns-resize;
                            moved => {
                                commits-height = clamp(commits-height + self.mouse-y - self.pressed-y,
                                    120px, root.height - 200px);
                            }
                        }
                    }
                    // ---- file tree (real hierarchical tree) ----
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.panel;
                        VerticalLayout {
                            Text {
                                text: "FILES (" + file-count + ")";
                                color: Theme.muted;
                                font-size: 10px;
                                font-weight: 700;
                                height: 22px;
                                vertical-alignment: center;
                            }
                            ListView {
                                for n[i] in tree: Rectangle {
                                    height: 26px;
                                    background: nta.has-hover ? Theme.hover : transparent;
                                    nta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (n.is-dir) {
                                                // folders carry their full-tree index in file-index
                                                root.toggle-node(n.file-index);
                                            } else {
                                                root.select-file(n.file-index);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-right: 8px;
                                        spacing: 4px;
                                        // indent by depth
                                        Rectangle { width: 8px + n.depth * 14px; }
                                        // disclosure arrow (folders only)
                                        Text {
                                            text: n.is-dir ? (n.expanded ? "▾" : "▸") : "";
                                            color: Theme.muted;
                                            font-size: 10px;
                                            width: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: n.icon;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: n.name;
                                            color: Theme.text;
                                            font-size: 12px;
                                            font-weight: n.is-dir ? 600 : 400;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        // per-file counts (leaves only)
                                        if !n.is-dir: Text {
                                            text: "+" + n.added;
                                            color: Theme.add-fg;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        if !n.is-dir: Text {
                                            text: "−" + n.removed;
                                            color: Theme.del-fg;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // ---- horizontal resize handle ----
            Rectangle {
                width: 6px;
                background: hh.has-hover ? Theme.accent : Theme.border;
                hh := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        side-width = clamp(side-width + self.mouse-x - self.pressed-x, 220px, 600px);
                    }
                }
            }

            // ----- MAIN DIFF VIEW -------------------------------------------
            Rectangle {
                background: Theme.bg;
                horizontal-stretch: 1;
                clip: true;
                flick := Flickable {
                    viewport-width: wrap-lines ? self.width : max(self.width, 2000px);
                    viewport-height: content.preferred-height;
                    changed viewport-y => { root.scrolled(-self.viewport-y); }
                    content := VerticalLayout {
                        for it in diff-items: Rectangle {
                            height: it.row-h;
                            background: it.kind == 1 ? Theme.panel
                                : it.code-kind == 1 ? Theme.add-bg
                                : it.code-kind == 2 ? Theme.del-bg
                                : it.code-kind == 3 ? Theme.hunk-bg
                                : transparent;

                            // ---- file header row ----
                            if it.kind == 1: Rectangle {
                                Rectangle {
                                    height: 1px; y: parent.height - 1px; background: Theme.border;
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: it.path;
                                        color: Theme.text;
                                        font-weight: 700;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text { text: "+" + it.added; color: Theme.add-fg;
                                        font-size: 12px; vertical-alignment: center; }
                                    Text { text: "−" + it.removed; color: Theme.del-fg;
                                        font-size: 12px; vertical-alignment: center; }
                                }
                            }

                            // ---- commit message block ----
                            if it.kind == 2: msg := VerticalLayout {
                                padding: 12px;
                                spacing: 3px;
                                Text { text: it.text; color: Theme.text; font-size: 17px;
                                    font-weight: 700; wrap: word-wrap; }
                                Text { text: it.sub; color: Theme.muted; font-size: 11px; }
                                Text { text: it.path; color: Theme.text;
                                    font-family: "monospace"; font-size: 12px;
                                    wrap: word-wrap; }
                            }

                            // ---- code line ----
                            if it.kind == 0: codeRow := HorizontalLayout {
                                spacing: 0px;
                                // gutter
                                if line-numbers && it.code-kind != 3: Text {
                                    text: it.old-no; width: diff-font * 2.6;
                                    color: Theme.muted; font-family: "monospace";
                                    font-size: diff-font; horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                if line-numbers && it.code-kind != 3: Text {
                                    text: it.new-no; width: diff-font * 2.6;
                                    color: Theme.muted; font-family: "monospace";
                                    font-size: diff-font; horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: diff-font * 1.4;
                                    background: it.code-kind == 1 ? Theme.add-mark
                                        : it.code-kind == 2 ? Theme.del-mark : transparent;
                                    Text {
                                        text: it.sign;
                                        color: it.code-kind == 1 ? Theme.add-fg
                                            : it.code-kind == 2 ? Theme.del-fg : Theme.muted;
                                        font-family: "monospace";
                                        font-size: diff-font;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                // code text: hunk header is one muted string; else colored spans
                                if it.code-kind == 3: Text {
                                    text: it.text;
                                    color: Theme.accent;
                                    font-family: "monospace";
                                    font-size: diff-font;
                                    vertical-alignment: center;
                                    padding-left: 6px;
                                }
                                if it.code-kind != 3: HorizontalLayout {
                                    padding-left: 6px;
                                    alignment: start;
                                    for s in it.spans: Text {
                                        text: s.text;
                                        color: s.col;
                                        font-family: "monospace";
                                        font-size: diff-font;
                                        wrap: wrap-lines ? word-wrap : no-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
                // ---- sticky file header overlay ----
                if sticky-visible: Rectangle {
                    y: 0;
                    height: 30px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: sticky-path; color: Theme.text; font-weight: 700;
                            font-size: 12px; vertical-alignment: center;
                            horizontal-stretch: 1; overflow: elide; }
                        Text { text: "+" + sticky-added; color: Theme.add-fg;
                            font-size: 12px; vertical-alignment: center; }
                        Text { text: "−" + sticky-removed; color: Theme.del-fg;
                            font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
