import { ScrollView, ListView } from "std-widgets.slint";

// ---- shared palette --------------------------------------------------------
global Palette {
    out property <color> bg: #ffffff;
    out property <color> panel: #f6f8fa;
    out property <color> border: #d0d7de;
    out property <color> text: #1f2328;
    out property <color> muted: #656d76;
    out property <color> accent: #0969da;
    out property <color> sel: #ddf4ff;
    out property <color> add-bg: #e6ffec;
    out property <color> add-mark: #abf2bc;
    out property <color> del-bg: #ffebe9;
    out property <color> del-mark: #ff8182;
    out property <color> add-fg: #1a7f37;
    out property <color> del-fg: #cf222e;
    out property <color> hunk-bg: #ddf4ff;
}

// ---- data structs (mirrored in Rust) --------------------------------------
export struct Span { text: string, col: color }

export struct CommitRow {
    short: string, date: string, author: string, title: string,
    current: bool, is-from: bool, is-to: bool, working: bool,
}

export struct FileRow { icon: string, path: string, added: int, removed: int }

// One row in the diff body. kind: 0 = code line, 1 = file header, 2 = commit message.
export struct DiffItem {
    kind: int,
    code-kind: int,   // 0 ctx, 1 add, 2 del, 3 hunk-header
    old-no: string,
    new-no: string,
    sign: string,
    spans: [Span],
    path: string,
    added: int,
    removed: int,
    text: string,
    sub: string,      // message subtitle
    row-h: length,    // precomputed row height (kept in sync with Rust offset math)
}

// ---- a toolbar tool button with a hover tooltip ---------------------------
component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active;
    callback clicked;
    width: 30px;
    height: 26px;
    border-radius: 5px;
    background: ta.has-hover ? (active ? Palette.sel : #eaeef2) : (active ? Palette.sel : transparent);
    Text {
        text: glyph;
        color: active ? Palette.accent : Palette.text;
        font-family: "monospace";
        font-size: 13px;
        font-weight: active ? 800 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover: Rectangle {
        y: parent.height + 4px;
        background: #1f2328;
        border-radius: 4px;
        width: tipText.preferred-width + 12px;
        height: tipText.preferred-height + 8px;
        z: 100;
        tipText := Text {
            text: tip;
            color: white;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component EndpointButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: active ? Palette.accent : #eaeef2;
    border-width: 1px;
    border-color: Palette.border;
    Text {
        text: glyph;
        color: active ? white : Palette.muted;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "git-review · slint";
    preferred-width: 1200px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    background: Palette.bg;

    // ---- inputs from Rust ----
    in property <[CommitRow]> commits;
    in property <[FileRow]> files;
    in property <[DiffItem]> diff-items;
    in property <string> summary;
    in property <int> total-added;
    in property <int> total-removed;
    in property <string> repo-name;
    // sticky header
    in property <string> sticky-path;
    in property <int> sticky-added;
    in property <int> sticky-removed;
    in property <bool> sticky-visible;
    // settings (driven by Rust)
    in property <bool> wrap-lines;
    in property <bool> show-space;
    in property <bool> line-numbers;
    in property <length> diff-font: 12px;

    // ---- callbacks to Rust ----
    callback select-commit(int);
    callback set-from(int);
    callback set-to(int);
    callback select-file(int);
    callback toggle-wrap();
    callback toggle-space();
    callback toggle-line-numbers();
    callback font-inc();
    callback font-dec();
    callback scrolled(length);       // reports scroll offset for sticky calc

    // resizable layout state
    property <length> side-width: 320px;
    property <length> commits-height: 360px;
    property <length> line-h: diff-font * 1.5;

    public function scroll-diff-to(y: length) {
        flick.viewport-y = -y;
        root.scrolled(y);
    }

    HorizontalLayout {
        // ===== LEFT SIDE PANEL ============================================
        Rectangle {
            width: side-width;
            background: Palette.panel;
            VerticalLayout {
                // ---- commit list ----
                Rectangle {
                    height: commits-height;
                    background: Palette.panel;
                    VerticalLayout {
                        Text {
                            text: "COMMITS · " + repo-name;
                            color: Palette.muted;
                            font-size: 10px;
                            font-weight: 700;
                            height: 22px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                        ListView {
                            for c[i] in commits: Rectangle {
                                height: 52px;
                                background: c.current ? Palette.sel : transparent;
                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-commit(i); }
                                }
                                Rectangle {
                                    height: 1px;
                                    y: parent.height - 1px;
                                    background: Palette.border;
                                }
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 6px;
                                    spacing: 3px;
                                    // line 1
                                    HorizontalLayout {
                                        spacing: 4px;
                                        height: 18px;
                                        if !c.working: EndpointButton {
                                            glyph: "◀";
                                            active: c.is-from;
                                            clicked => { root.set-from(i); }
                                        }
                                        if !c.working: EndpointButton {
                                            glyph: "▶";
                                            active: c.is-to;
                                            clicked => { root.set-to(i); }
                                        }
                                        Text {
                                            text: c.short;
                                            color: Palette.accent;
                                            font-family: "monospace";
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: c.date;
                                            color: Palette.muted;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: c.author;
                                            color: Palette.muted;
                                            font-size: 10px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            max-width: 110px;
                                        }
                                    }
                                    // line 2
                                    Text {
                                        text: c.title;
                                        color: Palette.text;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                // ---- vertical resize handle ----
                Rectangle {
                    height: 6px;
                    background: vh.has-hover ? Palette.accent : Palette.border;
                    vh := TouchArea {
                        mouse-cursor: ns-resize;
                        moved => {
                            commits-height = clamp(commits-height + self.mouse-y - self.pressed-y,
                                120px, root.height - 200px);
                        }
                    }
                }
                // ---- file tree ----
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.panel;
                    VerticalLayout {
                        Text {
                            text: "FILES (" + files.length + ")";
                            color: Palette.muted;
                            font-size: 10px;
                            font-weight: 700;
                            height: 22px;
                            vertical-alignment: center;
                        }
                        ListView {
                            for f[i] in files: Rectangle {
                                height: 26px;
                                background: fta.has-hover ? #eaeef2 : transparent;
                                fta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-file(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Text { text: f.icon; font-size: 13px; vertical-alignment: center; }
                                    Text {
                                        text: f.path;
                                        color: Palette.text;
                                        font-size: 12px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: "+" + f.added;
                                        color: Palette.add-fg;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "−" + f.removed;
                                        color: Palette.del-fg;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // ---- horizontal resize handle ----
        Rectangle {
            width: 6px;
            background: hh.has-hover ? Palette.accent : Palette.border;
            hh := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    side-width = clamp(side-width + self.mouse-x - self.pressed-x, 220px, 600px);
                }
            }
        }

        // ===== MAIN VIEW ==================================================
        Rectangle {
            background: Palette.bg;
            horizontal-stretch: 1;
            VerticalLayout {
                // ---- toolbar ----
                Rectangle {
                    height: 40px;
                    background: Palette.bg;
                    Rectangle {
                        height: 1px;
                        y: parent.height - 1px;
                        background: Palette.border;
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: summary;
                            color: Palette.text;
                            font-family: "monospace";
                            font-weight: 700;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "+" + total-added;
                            color: Palette.add-fg;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "−" + total-removed;
                            color: Palette.del-fg;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        HorizontalLayout {
                            spacing: 4px;
                            ToolButton { glyph: "⤶"; tip: "Word wrap"; active: wrap-lines;
                                clicked => { root.toggle-wrap(); } }
                            ToolButton { glyph: "␣"; tip: "Show space changes"; active: show-space;
                                clicked => { root.toggle-space(); } }
                            ToolButton { glyph: "A-"; tip: "Decrease font size";
                                clicked => { root.font-dec(); } }
                            ToolButton { glyph: "A+"; tip: "Increase font size";
                                clicked => { root.font-inc(); } }
                            ToolButton { glyph: "#"; tip: "Show line numbers"; active: line-numbers;
                                clicked => { root.toggle-line-numbers(); } }
                        }
                    }
                }
                // ---- diff body ----
                Rectangle {
                    background: Palette.bg;
                    vertical-stretch: 1;
                    clip: true;
                    flick := Flickable {
                        viewport-width: wrap-lines ? self.width : max(self.width, 2000px);
                        viewport-height: content.preferred-height;
                        changed viewport-y => { root.scrolled(-self.viewport-y); }
                        content := VerticalLayout {
                            for it in diff-items: Rectangle {
                                height: it.row-h;
                                background: it.kind == 1 ? Palette.panel
                                    : it.code-kind == 1 ? Palette.add-bg
                                    : it.code-kind == 2 ? Palette.del-bg
                                    : it.code-kind == 3 ? Palette.hunk-bg
                                    : transparent;

                                // ---- file header row ----
                                if it.kind == 1: Rectangle {
                                    Rectangle {
                                        height: 1px; y: parent.height - 1px; background: Palette.border;
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: it.path;
                                            color: Palette.text;
                                            font-weight: 700;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text { text: "+" + it.added; color: Palette.add-fg;
                                            font-size: 12px; vertical-alignment: center; }
                                        Text { text: "−" + it.removed; color: Palette.del-fg;
                                            font-size: 12px; vertical-alignment: center; }
                                    }
                                }

                                // ---- commit message block ----
                                if it.kind == 2: msg := VerticalLayout {
                                    padding: 12px;
                                    spacing: 3px;
                                    Text { text: it.text; color: Palette.text; font-size: 17px;
                                        font-weight: 700; wrap: word-wrap; }
                                    Text { text: it.sub; color: Palette.muted; font-size: 11px; }
                                    Text { text: it.path; color: Palette.text;
                                        font-family: "monospace"; font-size: 12px;
                                        wrap: word-wrap; }
                                }

                                // ---- code line ----
                                if it.kind == 0: codeRow := HorizontalLayout {
                                    spacing: 0px;
                                    // gutter
                                    if line-numbers && it.code-kind != 3: Text {
                                        text: it.old-no; width: diff-font * 2.6;
                                        color: Palette.muted; font-family: "monospace";
                                        font-size: diff-font; horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    if line-numbers && it.code-kind != 3: Text {
                                        text: it.new-no; width: diff-font * 2.6;
                                        color: Palette.muted; font-family: "monospace";
                                        font-size: diff-font; horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: diff-font * 1.4;
                                        background: it.code-kind == 1 ? Palette.add-mark
                                            : it.code-kind == 2 ? Palette.del-mark : transparent;
                                        Text {
                                            text: it.sign;
                                            color: it.code-kind == 1 ? Palette.add-fg
                                                : it.code-kind == 2 ? Palette.del-fg : Palette.muted;
                                            font-family: "monospace";
                                            font-size: diff-font;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // code text: hunk header is one muted string; else colored spans
                                    if it.code-kind == 3: Text {
                                        text: it.text;
                                        color: Palette.accent;
                                        font-family: "monospace";
                                        font-size: diff-font;
                                        vertical-alignment: center;
                                        padding-left: 6px;
                                    }
                                    if it.code-kind != 3: HorizontalLayout {
                                        padding-left: 6px;
                                        alignment: start;
                                        for s in it.spans: Text {
                                            text: s.text;
                                            color: s.col;
                                            font-family: "monospace";
                                            font-size: diff-font;
                                            wrap: wrap-lines ? word-wrap : no-wrap;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // ---- sticky file header overlay ----
                    if sticky-visible: Rectangle {
                        y: 0;
                        height: 30px;
                        background: Palette.panel;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text { text: sticky-path; color: Palette.text; font-weight: 700;
                                font-size: 12px; vertical-alignment: center;
                                horizontal-stretch: 1; overflow: elide; }
                            Text { text: "+" + sticky-added; color: Palette.add-fg;
                                font-size: 12px; vertical-alignment: center; }
                            Text { text: "−" + sticky-removed; color: Palette.del-fg;
                                font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
